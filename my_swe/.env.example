# ==========================================================
# 1. 大模型 API 配置 (支持 DeepSeek / 阿里云百炼 Qwen / OpenAI 等兼容接口)
# ==========================================================
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0.0

# Embedding 向量模型配置 (用于 Qdrant 语义检索)
EMBEDDING_API_KEY=sk-your-api-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL_NAME=text-embedding-v3

# ==========================================================
# 2. 存储引擎开关与连接配置
# 说明：USE_EXTERNAL_STORES=false 时，系统默认使用内置 SQLite + 内存模拟的
# ES/Qdrant/靶场库，无需安装任何外部中间件即可一键跑通全部 3 个排障剧本！
# 当设为 true 时，自动切换连接你本地真实的 MySQL / ES / Qdrant / Redis。
# ==========================================================
USE_EXTERNAL_STORES=false

# 平台自身管理数据库 (默认使用本地 SQLite 文件，可无缝切换为 mysql+aiomysql://root:123456@localhost:3306/rca_platform_db)
PLATFORM_DB_URL=sqlite+aiosqlite:///./rca_platform.db

# 被监控靶场项目的只读数据库连接串
TARGET_MALL_DB_URL=sqlite+aiosqlite:///./mall_target.db

# Elasticsearch 配置
ES_URL=http://localhost:9200
ES_RUNTIME_LOG_INDEX=mall-runtime-logs
ES_HISTORY_BM25_INDEX=historical-incidents-bm25

# Qdrant 向量库配置
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=historical_incidents_vec

# Redis 配置 (用于 LangGraph Checkpointer 断点恢复)
REDIS_URL=redis://localhost:6379/0
